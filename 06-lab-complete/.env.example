# ============================================================
# Biến môi trường của agent (tiêu chí 9). KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env   (file .env đã nằm trong .gitignore)
# Trên Railway / Render: đặt các biến này trong mục Variables của service.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — bắt buộc. Tạo key ngẫu nhiên:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=replace-with-a-long-random-string

# Redis — state dùng chung cho rate limit và cost guard
# (docker compose tự đặt redis://redis:6379/0 cho service agent)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD). Đạt một trong hai mức → HTTP 402
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
